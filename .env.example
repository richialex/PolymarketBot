WALLET_ADDRESS=0xYourWalletAddress
API_KEY=your-polymarket-api-key

# Encrypted Ethereum keystore. Create it once with:
# python -m src.keystore create --file secrets/wallet.json
# The app will prompt for its password at startup.
KEYSTORE_FILE=secrets/wallet.json

# Optional proxy
# HTTPS_PROXY=http://user:pass@host:port
# HTTP_PROXY=http://user:pass@host:port
